{
  "_description": "Skill Evolution Plane schema — Phase 8",
  "phase": 8,
  "principle": "Proposal-only — no automatic skill modification",
  "provider_types": [
    {
      "anthropic_skills_like": "Anthropic SKILL.md format alignment provider (BLOCKED)",
      "superclaude_like": "SuperClaude pattern/taxonomy provider (BLOCKED)",
      "deterministic_mock": "Deterministic mock provider (ALLOWED)",
      "generic": "Generic/custom provider"
    }
  ],
  "gap_signal_types": [
    "missing_skill",
    "outdated_skill",
    "poor_description",
    "missing_tests",
    "registry_mismatch",
    "format_alignment",
    "duplicate_skill"
